# Client Environment Variables
# API base URL for Express backend (leave empty for Vite localhost proxy)
VITE_API_URL=http://localhost:5000/api

# Real-Time UPI Scanner Configuration:
# Set your public UPI Virtual Payment Address (VPA) here to test real payments.
# DO NOT put your bank account number or password!
# Example: yourname@oksbi, yournumber@paytm, or university@upi
VITE_LIBRARY_UPI_ID=central.library@upi
VITE_LIBRARY_PAYEE_NAME=Central University Library
